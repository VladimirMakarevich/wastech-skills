%% Plan phases: the implementation order and its dependencies, from plan/index.md.
%% One node per phase, "NN - name" and what it delivers. existing = done, focus = in progress, new = not started.
flowchart LR
    p1["01 - Schema<br/>discount columns + migration"]:::existing
    p2["02 - Discount rules<br/>validation + unit tests"]:::focus
    p3["03 - API<br/>POST /orders/:id/promo"]:::new
    p4["04 - UI<br/>promo field + errors"]:::new

    p1 --> p2 --> p3 --> p4

    %% --- status kit (references/style.md): keep as is ---
