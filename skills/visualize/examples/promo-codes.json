    {
      "type": "notes", "id": "notes", "nav": "Risks",
      "eyebrow": "questions.md · out-of-scope.md",
      "title": "Risks, questions, and boundaries",
      "items": [
        { "title": "Race on the last use", "tone": "risk", "text": "Two orders apply a code with `used_count = max_uses − 1` at the same time. The check and the increment run in one transaction." },
        { "title": "Promo codes and sale prices", "tone": "question", "tag": "not blocking", "text": "Does the discount stack with a sale? Not for now: the code applies to the full price." },
        { "title": "Promo code admin", "tone": "out", "text": "Codes are added by migration or SQL; a marketing UI is a separate task." }
      ]
    }
  ],
